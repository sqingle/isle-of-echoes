# The Archivist's natural voice. Set ONE provider; with none, the app falls back to the device voice.
# Order of priority: Kokoro, then ElevenLabs, then OpenAI.

# Kokoro Web (free, open source): self-host https://github.com/eduardolat/kokoro-web and point at its API.
KOKORO_BASE_URL=            # e.g. https://kokoro.example.com/api/v1
# KOKORO_API_KEY=           # the server's KW_SECRET_API_KEY, if you set one
# KOKORO_VOICE=bm_fable     # e.g. bm_fable, bm_george (British male), af_heart (US female)
# KOKORO_MODEL=model_q8f16

OPENAI_API_KEY=
# ARCHIVIST_VOICE=sage          # OpenAI voice (alloy, ash, ballad, coral, echo, fable, nova, onyx, sage, shimmer, verse)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=          # pick a warm, older narrator voice from your ElevenLabs library
# ELEVENLABS_MODEL=eleven_turbo_v2_5

# The Keeper's Letter on /ledger (Claude). Without it the button explains that the letter is not set up.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
